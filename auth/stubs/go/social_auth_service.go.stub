package services

import (
	"crypto/rand"
	"database/sql"
	"encoding/base64"
	"fmt"
	"strings"
	"time"

	"__MODULE__/app/models"
	"github.com/zatrano/framework/v3/core/contracts"
	"github.com/zatrano/framework/v3/core/kernel/http"
	pkgauth "github.com/zatrano/packages/auth"
	"github.com/zatrano/packages/auth/social"
	"github.com/zatrano/packages/db"
	"github.com/zatrano/packages/hashing"
)

// SocialAuthService is the shared Google OAuth seam for web and API handlers.
type SocialAuthService struct {
	App contracts.App
}

func NewSocialAuthService(app contracts.App) *SocialAuthService {
	return &SocialAuthService{App: app}
}

func (s *SocialAuthService) Redirect(provider string) (url, state string, err error) {
	if s == nil || s.App == nil || social.From(s.App) == nil {
		return "", "", fmt.Errorf("auth.social_not_configured")
	}
	return social.From(s.App).Redirect(provider)
}

func (s *SocialAuthService) User(provider, code string) (*social.User, error) {
	if s == nil || s.App == nil || social.From(s.App) == nil {
		return nil, fmt.Errorf("auth.social_not_configured")
	}
	return social.From(s.App).User(provider, code)
}

func (s *SocialAuthService) Persist(socialUser *social.User) (*social.PersistResult, *models.User, error) {
	store, err := newSQLSocialPersistence(s.App)
	if err != nil {
		return nil, nil, err
	}
	result, err := social.Persist(store, socialUser)
	if err != nil || result == nil || result.UserID == 0 {
		return nil, nil, fmt.Errorf("auth.social_link_failed")
	}
	user, err := store.loadUser(result.UserID)
	if err != nil || user == nil {
		return nil, nil, fmt.Errorf("auth.social_user_load_failed")
	}
	return result, user, nil
}

func (s *SocialAuthService) Login(req *http.Request, user *models.User) error {
	if s == nil || s.App == nil {
		return fmt.Errorf("auth.guard_unavailable")
	}
	return pkgauth.From(s.App).Login(req, user)
}

func (s *SocialAuthService) ValidateState(state string) {
	if s == nil || s.App == nil || social.From(s.App) == nil {
		return
	}
	_ = social.From(s.App).ValidateState(state)
}

type sqlSocialPersistence struct {
	db *sql.DB
}

func newSQLSocialPersistence(app contracts.App) (*sqlSocialPersistence, error) {
	h, ok := db.SQLFrom(app)
	if !ok || h.DB == nil {
		return nil, fmt.Errorf("auth.database_unavailable")
	}
	return &sqlSocialPersistence{db: h.DB}, nil
}

func (p *sqlSocialPersistence) FindUserIDByProvider(provider, providerID string) (int64, error) {
	uid := models.ProviderUIDFor(strings.ToLower(provider), providerID)
	var id int64
	err := p.db.QueryRow(`SELECT user_id FROM social_accounts WHERE provider_uid = ? LIMIT 1`, uid).Scan(&id)
	if err == sql.ErrNoRows {
		return 0, nil
	}
	if err != nil {
		return 0, err
	}
	return id, nil
}

func (p *sqlSocialPersistence) FindUserIDByEmail(email string) (int64, error) {
	var id int64
	err := p.db.QueryRow(`SELECT id FROM users WHERE email = ? LIMIT 1`, email).Scan(&id)
	if err == sql.ErrNoRows {
		return 0, nil
	}
	if err != nil {
		return 0, err
	}
	return id, nil
}

func (p *sqlSocialPersistence) CreateUser(name, email, avatar string, emailVerified bool) (int64, error) {
	plain, err := randomOAuthPassword(24)
	if err != nil {
		return 0, err
	}
	hashed, err := hashing.Hash(plain)
	if err != nil {
		return 0, err
	}
	var verified any
	if emailVerified {
		verified = time.Now().UTC().Format(time.RFC3339)
	}
	res, err := p.db.Exec(
		`INSERT INTO users (name, email, password, avatar, email_verified_at, created_at, updated_at)
		 VALUES (?, ?, ?, ?, ?, datetime('now'), datetime('now'))`,
		name, email, hashed, avatar, verified,
	)
	if err != nil {
		return 0, err
	}
	return res.LastInsertId()
}

func (p *sqlSocialPersistence) SyncUser(userID int64, name, avatar string, emailVerified bool) error {
	user, err := p.loadUser(userID)
	if err != nil || user == nil {
		return fmt.Errorf("user %d not found", userID)
	}
	changed := false
	if name != "" && strings.TrimSpace(user.Name) == "" {
		user.Name = name
		changed = true
	}
	if avatar != "" && user.Avatar != avatar {
		user.Avatar = avatar
		changed = true
	}
	if emailVerified && !user.HasVerifiedEmail() {
		user.MarkEmailAsVerified()
		changed = true
	}
	if !changed {
		return nil
	}
	var verified any
	if user.EmailVerifiedAt != nil {
		verified = user.EmailVerifiedAt.UTC().Format(time.RFC3339)
	}
	_, err = p.db.Exec(
		`UPDATE users SET name = ?, avatar = ?, email_verified_at = ?, updated_at = datetime('now') WHERE id = ?`,
		user.Name, user.Avatar, verified, userID,
	)
	return err
}

func (p *sqlSocialPersistence) UpsertAccount(userID int64, socialUser *social.User) error {
	provider := strings.ToLower(strings.TrimSpace(socialUser.Provider))
	providerID := strings.TrimSpace(socialUser.ID)
	uid := models.ProviderUIDFor(provider, providerID)
	name := strings.TrimSpace(socialUser.Name)
	email := strings.ToLower(strings.TrimSpace(socialUser.Email))
	avatar := strings.TrimSpace(socialUser.Avatar)
	token := strings.TrimSpace(socialUser.Token)

	var existingID int64
	err := p.db.QueryRow(`SELECT id FROM social_accounts WHERE provider_uid = ? LIMIT 1`, uid).Scan(&existingID)
	if err != nil && err != sql.ErrNoRows {
		return err
	}
	if err == sql.ErrNoRows {
		_, err = p.db.Exec(
			`INSERT INTO social_accounts (user_id, provider, provider_id, provider_uid, name, email, avatar, access_token, created_at, updated_at)
			 VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'))`,
			userID, provider, providerID, uid, nullIfEmpty(name), nullIfEmpty(email), nullIfEmpty(avatar), nullIfEmpty(token),
		)
		return err
	}
	_, err = p.db.Exec(
		`UPDATE social_accounts SET user_id = ?, provider = ?, provider_id = ?, name = ?, email = ?, avatar = ?, access_token = ?, updated_at = datetime('now')
		 WHERE id = ?`,
		userID, provider, providerID, nullIfEmpty(name), nullIfEmpty(email), nullIfEmpty(avatar), nullIfEmpty(token), existingID,
	)
	return err
}

func (p *sqlSocialPersistence) loadUser(id int64) (*models.User, error) {
	var u models.User
	var verified sql.NullString
	err := p.db.QueryRow(
		`SELECT id, name, email, COALESCE(is_admin,0), password, COALESCE(avatar,''), email_verified_at FROM users WHERE id = ?`,
		id,
	).Scan(&u.ID, &u.Name, &u.Email, &u.IsAdmin, &u.Password, &u.Avatar, &verified)
	if err == sql.ErrNoRows {
		return nil, nil
	}
	if err != nil {
		return nil, err
	}
	if verified.Valid && verified.String != "" {
		if t, perr := time.Parse(time.RFC3339, verified.String); perr == nil {
			u.EmailVerifiedAt = &t
		}
	}
	return &u, nil
}

func nullIfEmpty(s string) any {
	if strings.TrimSpace(s) == "" {
		return nil
	}
	return s
}

func randomOAuthPassword(n int) (string, error) {
	buf := make([]byte, n)
	if _, err := rand.Read(buf); err != nil {
		return "", err
	}
	return base64.RawURLEncoding.EncodeToString(buf), nil
}
