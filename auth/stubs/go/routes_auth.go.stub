package web

import (
	approutes "__MODULE__/app/routes"
	authctrl "__MODULE__/app/http/controllers/auth/web"

	pkgauth "github.com/zatrano/packages/auth"
	"github.com/zatrano/packages/ratelimit"
	"github.com/zatrano/framework/v2/kernel/routing"
)

func init() {
	routing.RegisterWeb(registerAuth)
}

func registerAuth(router *routing.Router) {
	app := approutes.Current()
	if app == nil || router == nil {
		return
	}
	ctrl := &authctrl.AuthController{App: app}

	router.Group("/auth", func(r *routing.Router) {
		r.Get("/login", ctrl.LoginForm).As("login")
		r.Post("/login", ctrl.Login).As("login.attempt").Through(ratelimit.From(app).Named("login"))
		r.Post("/logout", ctrl.Logout).As("logout")

		r.Group("", func(g *routing.Router) {
			g.Get("/register", ctrl.RegisterForm).As("register")
			g.Post("/register", ctrl.Register).As("register.store").Through(ratelimit.From(app).Named("login"))
		}, pkgauth.RedirectIfAuthenticated(pkgauth.From(app), "/"))

		r.Get("/two-factor-challenge", ctrl.TwoFactorChallengeForm).As("two-factor.challenge")
		r.Post("/two-factor-challenge", ctrl.TwoFactorChallenge).As("two-factor.challenge.store")

		r.Get("/forgot-password", ctrl.ForgotForm).As("password.request")
		r.Post("/forgot-password", ctrl.Forgot).As("password.email").Through(ratelimit.From(app).Named("login"))
		r.Get("/reset-password", ctrl.ResetForm).As("password.reset")
		r.Post("/reset-password", ctrl.Reset).As("password.update")
		r.Get("/email/verify/{id}", ctrl.Verify).As("verification.verify")

		r.Group("", func(g *routing.Router) {
			g.Get("/confirm-password", ctrl.ConfirmPasswordForm).As("password.confirm")
			g.Post("/confirm-password", ctrl.ConfirmPassword).As("password.confirm.store")
			g.Get("/email/verify", ctrl.Notice).As("verification.notice")
			g.Post("/email/verification-notification", ctrl.Send).As("verification.send")

			g.Group("", func(gg *routing.Router) {
				gg.Get("/profile", ctrl.ProfileForm).As("profile")
				gg.Post("/profile", ctrl.UpdateProfile).As("profile.update")
				gg.Get("/password/change", ctrl.ChangePasswordForm).As("password.change")
				gg.Post("/password/change", ctrl.ChangePassword).As("password.change.store")
				gg.Get("/user/two-factor", ctrl.TwoFactorForm).As("two-factor.index")
				gg.Post("/user/two-factor/enable", ctrl.EnableTwoFactor).As("two-factor.enable")
				gg.Post("/user/two-factor/confirm", ctrl.ConfirmTwoFactor).As("two-factor.confirm")
				gg.Post("/user/two-factor/disable", ctrl.DisableTwoFactor).As("two-factor.disable")
				gg.Post("/user/two-factor/recovery-codes", ctrl.RegenerateRecoveryCodes).As("two-factor.recovery-codes")
				gg.Get("/user/logout-other-devices", ctrl.LogoutOtherDevicesForm).As("logout-other-devices")
				gg.Post("/user/logout-other-devices", ctrl.LogoutOtherDevices).As("logout-other-devices.store")
			}, pkgauth.VerifyEmailMiddleware(pkgauth.From(app)))
		}, pkgauth.Middleware(pkgauth.From(app)))
	})
}
